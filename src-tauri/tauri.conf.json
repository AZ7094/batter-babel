{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Batter Babel",
  "version": "0.10.0",
  "identifier": "com.batterbabel.desktop",
  "build": {
    "frontendDist": "../src/public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Batter Babel",
        "width": 780,
        "height": 640,
        "minWidth": 640,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": ["../scripts/optimization.ps1", "../scripts/ip-core.ps1", "../scripts/cf-probe.ps1"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
