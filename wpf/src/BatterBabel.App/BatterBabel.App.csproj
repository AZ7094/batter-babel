<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WPF 原型主程序（WinExe）。
    * 目标框架 net10.0-windows：.NET 10 是 LTS（EOL 2028-11-14），WPF 只有 Windows 目标可用。
    * 无 PackageReference：原型只用 BCL + WPF，restore 不访问网络（配合 ../NuGet.config 的 <clear/>）。
    * ApplicationManifest：PerMonitorV2 DPI + asInvoker（不请求管理员；原型不碰 hosts）。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>BatterBabel</AssemblyName>
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <Product>Batter Babel</Product>
    <Company>Batter Babel</Company>
    <RootNamespace>BatterBabel.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../../assets/icons/batter-babel.ico</ApplicationIcon>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BatterBabel.Core\BatterBabel.Core.csproj" />
    <!-- WebView2 是官方 SDK（非自研）：复用已发布版的 HTML 界面，宿主只做通道与命令适配。
         包从 wpf/NuGet.config 的本地 feed 还原，restore 不访问公网。 -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <!-- 便携目录：把页面与图标放到 exe 旁的 assets/，脱离仓库也能跑（PageAssets 优先读这里）。
       页面源在 src/web，构建时整体复制到输出 assets/。 -->
  <ItemGroup>
    <Content Include="..\..\..\src\web\**\*"
             Link="assets\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\assets\icons\batter-babel.ico"
             Link="assets\batter-babel.ico"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
