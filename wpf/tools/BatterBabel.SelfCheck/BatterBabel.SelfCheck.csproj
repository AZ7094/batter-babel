<Project Sdk="Microsoft.NET.Sdk">

  <!--
    自检程序：不依赖任何测试框架（本机 NuGet 不可用），用普通控制台断言跑 Core 的行为契约。
    退出码 0 = 全部通过；1 = 有失败（打印失败项）。这不是完整测试套件，只守住原型阶段最容易错的三件事：
    排序语义、目录数据、以及"模拟器不得伪装成真实结果 / 不得写 hosts"。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>BatterBabel.SelfCheck</AssemblyName>
    <RootNamespace>BatterBabel.SelfCheck</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BatterBabel.Core\BatterBabel.Core.csproj" />
  </ItemGroup>

</Project>
