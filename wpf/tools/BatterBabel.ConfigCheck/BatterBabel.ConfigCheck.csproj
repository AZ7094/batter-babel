<Project Sdk="Microsoft.NET.Sdk">

  <!--
    S10 自检工具：只验证 BatterBabel.Core.GameConfig.ManagedConfigFile 的文件层行为。
    刻意不进解决方案、不引测试框架（本机 NuGet 不可用）：断言用普通控制台 + 退出码表达。
    所有读写都发生在系统临时目录的一次性子目录里，不碰真实游戏目录。
    退出码：0 全部通过 / 1 有失败 / 2 参数用法错误。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>BatterBabel.ConfigCheck</AssemblyName>
    <RootNamespace>BatterBabel.ConfigCheck</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BatterBabel.Core\BatterBabel.Core.csproj" />
  </ItemGroup>

</Project>
