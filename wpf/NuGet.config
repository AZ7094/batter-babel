<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- 离线源：WebView2 依赖包已随仓库提供，克隆后无需联网即可还原。 -->
    <add key="packages" value="packages" />
    <!-- 在线源：只在需要升级依赖或拉取其它包时使用。 -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
